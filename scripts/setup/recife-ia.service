[Unit]
Description=Pontos Históricos do Recife - IA Educacional
After=network.target

[Service]
Type=simple
User=seu-usuario
WorkingDirectory=/caminho/para/pontosTuristicosRecife
Environment="PATH=/caminho/para/venv/bin"
ExecStart=/caminho/para/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 --timeout 120 src.main:app
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
